# ==============================================================================
# CIVICFIX AI - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Note: Do NOT commit actual secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vercel / Vite client-side variables)
# ------------------------------------------------------------------------------

# VITE_API_BASE_URL: URL of deployed backend on Render (e.g. https://civicfix-backend.onrender.com)
# Leave empty for local development when running monolithic dev server.
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Render / Node.js Express server)
# ------------------------------------------------------------------------------

# Server environment and port
NODE_ENV=development
PORT=3000

# Database: Supabase PostgreSQL connection string (Pooling / Transaction mode with SSL)
DATABASE_URL=

# Fallback individual database variables (optional for local PostgreSQL)
SQL_HOST=
SQL_PORT=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_SSL=

# AI: Google Gemini API Key for autonomous civic triage and vision analysis
GEMINI_API_KEY=

# CORS: Comma-separated list of allowed frontend origins (e.g. Vercel deployment URL)
ALLOWED_ORIGINS=

# Application URL (used for self-referential links or webhooks)
APP_URL=

# MapTiler API Key (optional for vector map tiles; falls back to OpenStreetMap if empty)
MAPTILER_API_KEY=
